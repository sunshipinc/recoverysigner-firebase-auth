#. js-lingui-explicit-id
#: src/config/i18n.ts:36
msgid "Please update Android WebView to start the session."
msgstr "Actualice Android WebView para iniciar sesión."

#. js-lingui-explicit-id
#: src/config/i18n.ts:37
msgid "Please update Google Chrome to start the session."
msgstr "Actualice Google Chrome para iniciar sesión."

#. js-lingui-explicit-id
#: src/config/i18n.ts:38
msgid "Your device's browser is not compatible. Please update your browser and Vibrant to the latest version."
msgstr "El navegador de tu dispositivo no es compatible. Actualizá tu navegador o bajate la última versión de Vibrant."

#: src/components/SentVerificationEmail.tsx:21
msgid "If the below email address is associated with an account, you will receive a verification email."
msgstr "Si la dirección de email, aquí debajo, está asociada con una cuenta, vas a recibir un email de verificación."

#: src/components/SentVerificationEmail.tsx:34
msgid "Please check your email on your device and click the verification link in the email message to proceed."
msgstr "Por favor, abrí en tu celular el correo que te enviamos y hacé clic en el link de verificación para proceder."

#: src/components/ConfirmVerificationEmail.tsx:53
#: src/components/SendVerificationCode.tsx:43
#: src/components/SendVerificationEmail.tsx:47
msgid "Please wait…"
msgstr "Por favor esperá…"

#: src/components/ErrorMessage.tsx:20
msgid "Ref: {reference}"
msgstr "Ref.: {reference}"

#: src/components/ConfirmVerificationCode.tsx:124
#: src/components/SentVerificationEmail.tsx:46
msgid "Resend"
msgstr "Reenviar"

#: src/components/ConfirmVerificationCode.tsx:122
msgid "Resend in {cooldownSeconds}s"
msgstr "Reenviar en {cooldownSeconds} s"

#: src/components/SendVerificationCode.tsx:47
msgid "Send verification code"
msgstr "Enviar código de verificación"

#: src/components/ConfirmVerificationCode.tsx:120
msgid "Sending a new code…"
msgstr "Enviando un código nuevo…"

#: src/helpers/getFirebaseError.ts:42
msgid "The code you entered is incorrect. Check the SMS and enter the 6-digit code again, or tap Resend to get a new code."
msgstr "El código que ingresaste es incorrecto. Revisá el SMS e ingresá el código de 6 dígitos de nuevo, o tocá Reenviar para recibir un código nuevo."

#: src/helpers/getFirebaseError.ts:46
msgid "This code has expired. Tap Resend to get a new code."
msgstr "Este código venció. Tocá Reenviar para recibir un código nuevo."

#: src/helpers/getFirebaseError.ts:63
msgid "This email is already in use. Please use another one."
msgstr "Este email ya está en uso. Por favor, usá otro."

#: src/helpers/getFirebaseError.ts:73
msgid "This is taking longer than expected. Check your internet connection and try again."
msgstr "Esto está tardando más de lo esperado. Revisá tu conexión a internet y volvé a intentarlo."

#: src/helpers/getFirebaseError.ts:50
msgid "This phone number isn’t valid. Go back and check that your phone number is correct."
msgstr "Este número de teléfono no es válido. Volvé atrás y revisá que tu número sea correcto."

#: src/helpers/getFirebaseError.ts:67
msgid "This sign-in link is invalid or has expired. Go back and request a new link."
msgstr "Este link de inicio de sesión no es válido o venció. Volvé atrás y pedí un link nuevo."

#: src/helpers/getFirebaseError.ts:53
msgid "Too many attempts. Please wait a few minutes before trying again."
msgstr "Demasiados intentos. Esperá unos minutos antes de volver a intentarlo."

#: src/components/SendVerificationCode.tsx:45
msgid "Try again"
msgstr "Intentar de nuevo"

#: src/helpers/getFirebaseError.ts:56
msgid "We can’t send verification codes right now. Please try again in a few hours."
msgstr "No podemos enviar códigos de verificación en este momento. Volvé a intentarlo en unas horas."

#: src/helpers/getFirebaseError.ts:60
msgid "We couldn’t complete the security check. Please try again and complete the challenge if one appears."
msgstr "No pudimos completar la verificación de seguridad. Volvé a intentarlo y completá la verificación si aparece."

#: src/helpers/getFirebaseError.ts:78
msgid "We couldn’t complete this step. Please try again in a few minutes. If it keeps happening, contact support with the reference below."
msgstr "No pudimos completar este paso. Volvé a intentarlo en unos minutos. Si sigue pasando, contactá a soporte con la referencia de abajo."

#: src/helpers/getFirebaseError.ts:70
msgid "We couldn’t connect. Check your internet connection and try again."
msgstr "No pudimos conectarnos. Revisá tu conexión a internet y volvé a intentarlo."

#: src/components/ConfirmVerificationCode.tsx:103
msgid "We’ve sent you a new code."
msgstr "Te mandamos un código nuevo."

#: src/components/ConfirmVerificationCode.tsx:72
msgid "We’ve sent you a verification code:"
msgstr "Te hemos enviado un código de verificación:"

#: src/components/ConfirmVerificationCode.tsx:62
#: src/components/ConfirmVerificationEmail.tsx:40
msgid "You’ve been verified! Please wait."
msgstr "¡Has sido verificado! Por favor espera."
